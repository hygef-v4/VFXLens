 "lines": [
  {"id": "l1", "scene": "s1", "speaker": "narrator", "vo": "Every night at nine, Mira checked the bank's books one last time."},
  {"id": "l2", "scene": "s1", "speaker": "mira", "vo": "One cent is missing. Again."},
  {"id": "l3", "scene": "s1", "speaker": "boss", "vo": "One cent? Go home, Mira."},
  {"id": "l4", "scene": "s2", "speaker": "narrator", "vo": "But one cent, every night, adds up."},
  {"id": "l5", "scene": "s3", "speaker": "narrator", "vo": "She followed the cent from the city bank to a quiet harbor town."},
  {"id": "l6", "scene": "s4", "speaker": "narrator", "vo": "There, someone had just bought an old lighthouse. With pennies."},
  {"id": "l7", "scene": "s5", "speaker": "mira", "vo": "Found you."}
 ]
